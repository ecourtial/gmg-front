{% extends 'base.html.twig' %}

{% block body %}
    <form method="POST" action="">
        <fieldset>
            <div class="form-group">
                <label for="platformId">{{ 'entity.platform'|trans }}</label>
                <select id="platformId" name="platformId">
                    {% for platform in platforms %}
                        <option value="{{ platform.id }}" {% if platform.id == selectedPlatform %}selected{% endif %}>
                            {{ platform.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label for="gameId">{{ 'entity.game'|trans }}</label>
                <select id="gameId" name="gameId">
                    {% for game in games %}
                        <option value="{{ game.id }}" {% if game.id == selectedGame %}selected{% endif %}>
                            {{ game.title }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label for="releaseYear">{{ 'entity.releaseYear'|trans }}</label>
                <input
                    type="number"
                    id="releaseYear"
                    name="releaseYear"
                    value="{{ version.releaseYear|default('') }}"
                    class="form-control"
                />
            </div>

            <div class="form-group">
                <label for="todoSoloSometimes">{{ 'entity.todoSoloSometimes'|trans }}</label>
                <select id="todoSoloSometimes" name="todoSoloSometimes">
                    <option value="0" {% if not version.todoSoloSometimes %}selected{% endif %}>
                        {{ 'see.no'|trans }}
                    </option>
                    <option value="1" {% if version.todoSoloSometimes %}selected{% endif %}>
                        {{ 'see.yes'|trans }}
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label for="todoMultiplayerSometimes">{{ 'entity.todoMultiplayerSometimes'|trans }}</label>
                <select id="todoMultiplayerSometimes" name="todoMultiplayerSometimes">
