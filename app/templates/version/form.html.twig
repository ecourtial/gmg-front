            </div>

            <div class="form-group">
                <label for="comments">{{ 'entity.comments'|trans }}</label>
                <br/>
                <textarea id="comments" name="comments">{{ version.comments|default('') }}</textarea>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_version') }}" />

            <button type="submit" id="loginSubmitButton" class="btn btn-primary">
                <i class="fa fa-sign-in" aria-hidden="true"></i>
                {{ 'menu.save'|trans }}
            </button>
        </fieldset>
    </form>
{% endblock %}
