            </div>

            <div class="form-group">
                <label for="finished">{{ 'entity.finished'|trans }}</label>
                <select id="finished" name="finished">
                    <option value="0" {% if not version.finished %}selected{% endif %}>
                        {{ 'see.no'|trans }}
