{% extends 'base.html.twig' %}
{% block body %}
    <form method="POST" action="">
        <fieldset>
            <div class="form-group">
                <label>
                    {{ 'magazine_label'|trans }}
                    <select name="magazineId">
                        {% for magazine in magazines %}
                            <option value="{{ magazine['id'] }}" {% if magazine['id'] == selectedMagazine %}selected{% endif %}>{{ magazine['title'] }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <div class="form-group">
                <label for="issueNumber">{{ 'issue_number'|trans }}</label>
                <input type="text" id="issueNumber" name="issueNumber" value="{{ issue['issueNumber']|default('') }}" class="form-control"/>
            </div>
            <div class="form-group">
                <label for="year">{{ 'see.year'|trans }}</label>
                <input type="text" id="year" name="year" value="{{ issue['year']|default('') }}" class="form-control"/>
            </div>
            <div class="form-group">
                <label for="month">{{ 'see.month'|trans }}</label>
                <input type="text" id="month" name="month" value="{{ issue['month']|default('') }}" class="form-control"/>
            </div>
            <div class="form-group">
                <label for="notes">{{ 'games_notes'|trans }}</label>
                <textarea id="notes" name="notes" class="form-control">{{ issue['notes']|default('') }}</textarea>
            </div>
        </fieldset>
        <fieldset>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_magazine_issue') }}" />
            <button type="submit" id="loginSubmitButton" class="btn btn-primary">
                <i class="fa fa-sign-in" aria-hidden="true"></i> {{ 'menu.save'|trans }}
            </button>
        </fieldset>
    </form>
{% endblock %}
