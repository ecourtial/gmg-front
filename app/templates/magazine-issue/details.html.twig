{% extends 'base.html.twig' %}
{% block body %}
    {% if is_granted('ROLE_USER') %}
    <em>{{ issue.notes }}</em>
    {% endif %}
    <p>
        <a href="{{ path('magazine_details', {id: issue.magazineId}) }}">{{ 'see_magazine_issues_list'|trans }}</a>
    </p>
    <hr>
    {% if is_granted('ROLE_USER') %}
        <form action="{{ url('delete_magazine_issue', {id: issue.id}) }}" method="post" data-confirmation="true" id="delete-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_magazine_issue') }}" />
            <button type="submit" id="deletePostSubmitButton" class="btn btn-lg btn-block btn-danger" onclick="return areYouSure('{{ 'delete_entry_confirmation'|trans }}');">
                <i class="fa fa-trash" aria-hidden="true"></i>
                {{ 'delete_action'|trans }}
            </button>
        </form>
        <br/>
        <a href="{{ url('edit_magazine_issue', {'id': issue.id}) }}">
            <button type="submit" class="btn btn-lg btn-block btn-outline-info">
                <i class="fa fa-trash" aria-hidden="true"></i>
                {{ 'menu.edit'|trans }}
            </button>
        </a>
        <a href="{{ url('add_magazine_issue_copy', {'issueId': issue.id}) }}">
            <button type="submit" class="btn btn-lg btn-block btn-success">
                <i class="fa fa-trash" aria-hidden="true"></i>
                {{ 'menu.add_copy'|trans }}
            </button>
        </a>
        <a href="{{ url('add_game_magazine_mention', {'issueId': issue.id}) }}">
            <button type="submit" class="btn btn-lg btn-block btn-success">
                <i class="fa fa-trash" aria-hidden="true"></i>
                {{ 'menu.add_mention_in_magazine'|trans }}
            </button>
        </a>
    {% endif %}
    <hr>
    <h2 class="colored_h2">{% trans %}copies{% endtrans %}</h2>
    <table class="table">
        <thead>
        <tr>
            <th scope="col">{% trans %} entity.id {% endtrans %}</th>
            <th scope="col">{% trans %} entity.type {% endtrans %}</th>
            <th scope="col">{% trans %} entity.notes {% endtrans %}</th>
            <th scope="col">{% trans %} menu.actions {% endtrans %}</th>
        </tr>
        </thead>
        <tbody>
        {% for copy in copies %}
            <tr>
                <td>{{ copy.id }}</td>
                <td>{{ copy.type }}</td>
                <td>{% if is_granted('ROLE_USER') %}{{ copy.notes }}{% endif %}</td>
                <td>
                    {% if is_granted('ROLE_USER') %}
                        <form action="{{ url('delete_magazine_issue_copy', {id: copy.id}) }}" method="post" data-confirmation="true" id="delete-form">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_magazine_issue_copy') }}" />
                            <button type="submit" id="deletePostSubmitButton" class="btn btn-lg btn-block btn-danger btn-in-list" onclick="return areYouSure('{{ 'delete_entry_confirmation'|trans }}');">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                                {{ 'delete_action'|trans }}
                            </button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <hr>
    <h2 class="colored_h2">{% trans %}games_mentions{% endtrans %}</h2>

    {% for mentionType, platform in mentions %}
        <h3 class="colored_h3">{{ mentionType|trans()}}</h3>
        {% for platformName, platformData in platform %}
            <h4 class="colored_h4">{{ platformName }}</h4>
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">{% trans %} entity.id {% endtrans %}</th>
                    <th scope="col">{% trans %} games_title {% endtrans %}</th>
                    <th scope="col">{% trans %} page_number {% endtrans %}</th>
                    <th scope="col">{% trans %} entity.notes {% endtrans %}</th>
                    <th scope="col">{% trans %} menu.actions {% endtrans %}</th>
                </tr>
                </thead>
                <tbody>
                {% for versionData in platformData %}
                    <tr>
                        <td>{{ versionData.id }}</td>
                        <td>{{ versionData.gameTitle }} - <a href="{{ path('version_details', {id: versionData.gameVersionId}) }}">{{ 'see.details'|trans }}</a></td>
                        <td>{{ versionData.pageNumber }}</td>
                        <td>{% if is_granted('ROLE_USER') %}{{ versionData.notes }}{% endif %}</td>
                        <td>
                            {% if is_granted('ROLE_USER') %}
                                <form action="{{ url('delete_game_magazine_mention', {id: versionData.id}) }}" method="post" data-confirmation="true" id="delete-form">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_game_magazine_mention') }}" />
                                    <button type="submit" id="deletePostSubmitButton" class="btn btn-lg btn-block btn-danger btn-in-list" onclick="return areYouSure('{{ 'delete_entry_confirmation'|trans }}');">
                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                        {{ 'delete_action'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    {% endfor %}

{% endblock %}

