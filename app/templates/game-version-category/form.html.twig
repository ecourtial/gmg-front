{% extends 'base.html.twig' %}
{% block body %}
    <form method="POST" action="">
        <fieldset>
            <div class="form-group">
                <label for="name">{{ 'category_name'|trans }}</label>
                <input type="text" id="name" name="name" value="{{ category.name|default('') }}" class="form-control"/>
            </div>
            <div class="form-group">
                <label for="description">{{ 'category_description'|trans }}</label>
                <textarea id="description" name="description" class="form-control">{{ category.description|default('') }}</textarea>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_game_version_category') }}" />
            <button type="submit" id="loginSubmitButton" class="btn btn-primary">
                <i class="fa fa-sign-in" aria-hidden="true"></i> {{ 'menu.save'|trans }}
            </button>
        </fieldset>
    </form>
{% endblock %}
