{% extends 'base.html.twig' %}
{% block body %}
    <a href="{{ url('game_version_categories_list') }}">{{ 'return_to_categories'|trans }}</a>
    {% if is_granted('ROLE_USER') %}
        <hr>
        <p>{{ 'category_description'|trans }}: <i>{{ category.description|default('')|raw|nl2br }}</i></p>
        <form action="{{ url('delete_game_version_category', {id: category.id}) }}" method="post" data-confirmation="true" id="delete-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_game_version_category') }}" />
            <button type="submit" id="deletePostSubmitButton" class="btn btn-lg btn-block btn-danger" onclick="return areYouSure('{{ 'delete_entry_confirmation'|trans }}');">
                <i class="fa fa-trash" aria-hidden="true"></i>
                {{ 'delete_action'|trans }}
            </button>
        </form>
        <br/>
        <a href="{{ url('edit_game_version_category', {'id': category.id}) }}">
            <button type="submit" class="btn btn-lg btn-block btn-outline-info">
                <i class="fa fa-trash" aria-hidden="true"></i>
                {{ 'menu.edit'|trans }}
            </button>
        </a>
        <a href="{{ url('add_game_version_to_category') }}?category={{ category.id }}">
            <button type="submit" class="btn btn-lg btn-block btn-success">
                <i class="fa fa-trash" aria-hidden="true"></i>
                {{ 'add_a_version_to_this_category'|trans }}
            </button>
        </a>
    {% endif %}
    <hr>
    {% include 'version/list-content.html.twig' with {
        extra_actions_template: 'game-version-category/versions-actions.html.twig'
    } %}
{% endblock %}
