{% extends 'base.html.twig' %}
{% block body %}
    <form method="POST" action="">
        <fieldset>
            <div class="form-group">
                <label>
                    {{ 'entity.version'|trans }}
                    <select name="versionId">
                        {% for version in versions %}
                            <option value="{{ version.id }}" {% if version.id == selectedVersion %}selected{% endif %}>{{ version.gameTitle }} ({{ version.platformName }})</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <div class="form-group">
                <label>
                    {{ 'category'|trans }}
                    <select name="categoryId">
                        {% for category in categories %}
                            <option value="{{ category.id }}" {% if category.id == selectedCategory %}selected{% endif %}>{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>
            <div class="form-group">
                <label for="notes">{{ 'entity.notes'|trans }}</label>
                <br/>
                <textarea name="notes"></textarea>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_version_to_category') }}" />
            <button type="submit" id="loginSubmitButton" class="btn btn-primary">
                <i class="fa fa-sign-in" aria-hidden="true"></i> {{ 'menu.save'|trans }}
            </button>
        </fieldset>
    </form>
{% endblock %}
