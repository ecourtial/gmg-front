{% extends 'base.html.twig' %}
{% block body %}
    <form method="POST" action="">
        <fieldset>
            <div class="form-group">
                <label for="type">{{ 'entity.type'|trans }}</label>
                <select name="type">
                    {% for type in copyTypes %}
                        <option value="{{ type.value }}">
                            {{ type.value|trans }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label for="notes">{{ 'menu.notes'|trans }}</label>
                <textarea id="notes" name="notes" class="form-control"></textarea>
            </div>
            <input type="hidden" name="magazineIssueId" value="{{ issueId }}" />
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_magazine_issue_copy') }}" />
            <button type="submit" id="loginSubmitButton" class="btn btn-primary">
                <i class="fa fa-sign-in" aria-hidden="true"></i> {{ 'menu.save'|trans }}
            </button>
        </fieldset>
    </form>
{% endblock %}
